config_version=5

[application]

config/name="Emergent: The Last Signal"
run/main_scene="res://scenes/forest3d.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1000
window/size/viewport_height=640
window/size/window_width_override=1000
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.063, 0.074, 1)
